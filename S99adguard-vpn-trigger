#!/bin/sh

CONFIG_FILE="/opt/etc/adguard-vpn-trigger.conf"
PIDFILE="/opt/var/run/adguard-vpn-trigger.pid"
INTERVAL=60
SCRIPT="/opt/scripts/adguard-vpn-trigger.sh"
LOG="/opt/var/log/adguard-vpn-trigger.status"

if [ -r "$CONFIG_FILE" ]; then
    . "$CONFIG_FILE"
fi

start() {
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        echo "already running, pid=$(cat "$PIDFILE")"
        return
    fi

    mkdir -p /opt/var/run /opt/var/log
    rm -f /opt/var/run/adguardvpn.state
    rm -f /opt/var/run/adguardvpn.rules.applied
    rm -f /opt/var/run/adguardvpn.clients
    rm -f /opt/var/run/adguardvpn.clients.new
    rmdir /opt/var/run/adguardvpn-trigger.lock 2>/dev/null || true
    touch "$LOG"

    (
        trap 'exit 0' HUP INT TERM
        while true; do
            {
                echo "$(date) run trigger"
                "$SCRIPT"
            } > "$LOG" 2>&1
            sleep "$INTERVAL"
        done
    ) </dev/null >/dev/null 2>&1 &

    echo $! > "$PIDFILE"
    sleep 1

    if kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        echo "started, pid=$(cat "$PIDFILE")"
    else
        echo "failed to start"
        rm -f "$PIDFILE"
    fi
}

stop() {
    if [ -f "$PIDFILE" ]; then
        pid="$(cat "$PIDFILE")"
        kill "$pid" 2>/dev/null
        i=0
        while kill -0 "$pid" 2>/dev/null && [ "$i" -lt 5 ]; do
            sleep 1
            i=$((i + 1))
        done
        rm -f "$PIDFILE"
        echo "stopped"
    else
        echo "not running"
    fi
}

status() {
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        echo "running, pid=$(cat "$PIDFILE")"
    else
        echo "not running"
    fi

    echo "--- last trigger status ---"
    cat "$LOG" 2>/dev/null
}

restart() {
    stop
    sleep 1
    start
}

case "$1" in
    start) start ;;
    stop) stop ;;
    restart) restart ;;
    status) status ;;
    *) echo "Usage: $0 {start|stop|restart|status}" ;;
esac
