#!/bin/sh

if [ "${ADGUARD_TRIGGER_CLEAN_ENV:-0}" != "1" ]; then
    exec env -i \
        PATH=/opt/bin:/opt/sbin:/usr/bin:/bin:/usr/sbin:/sbin \
        HOME=/ USER=root ADGUARD_TRIGGER_CLEAN_ENV=1 \
        "$0" "$@"
fi

CONFIG_FILE="/opt/etc/adguard-vpn-trigger.conf"
PIDFILE="/opt/var/run/adguard-vpn-trigger.pid"
INTERVAL=60
SCRIPT="/opt/scripts/adguard-vpn-trigger.sh"
LOG="/opt/var/log/adguard-vpn-trigger.status"

if [ -r "$CONFIG_FILE" ]; then
    . "$CONFIG_FILE"
fi

service_running() {
    [ -r "$PIDFILE" ] || return 1
    pid="$(cat "$PIDFILE" 2>/dev/null)"
    case "$pid" in
        ''|*[!0-9]*) rm -f "$PIDFILE"; return 1 ;;
    esac

    if [ ! -r "/proc/$pid/cmdline" ] || ! tr '\000' ' ' < "/proc/$pid/cmdline" | grep -q '/opt/etc/init.d/S99adguard-vpn-trigger'; then
        rm -f "$PIDFILE"
        return 1
    fi

    return 0
}

start() {
    if service_running; then
        echo "already running, pid=$(cat "$PIDFILE")"
        return
    fi

    mkdir -p /opt/var/run /opt/var/log
    rm -f /opt/var/run/adguardvpn.state
    rm -f /opt/var/run/adguardvpn.rules.applied
    rm -f /opt/var/run/adguardvpn.clients
    rm -f /opt/var/run/adguardvpn.clients.new
    rmdir /opt/var/run/adguardvpn-trigger.lock 2>/dev/null || true
    touch "$LOG"

    (
        trap '' HUP
        trap 'exit 0' INT TERM
        while true; do
            {
                echo "$(date) run trigger"
                "$SCRIPT"
            } > "$LOG" 2>&1
            sleep "$INTERVAL"
        done
    ) </dev/null >/dev/null 2>&1 &

    echo $! > "$PIDFILE"
    sleep 1

    if kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        echo "started, pid=$(cat "$PIDFILE")"
    else
        echo "failed to start"
        rm -f "$PIDFILE"
    fi
}

stop() {
    if service_running; then
        pid="$(cat "$PIDFILE")"
        kill "$pid" 2>/dev/null
        i=0
        while kill -0 "$pid" 2>/dev/null && [ "$i" -lt 5 ]; do
            sleep 1
            i=$((i + 1))
        done
        kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null || true
        rm -f "$PIDFILE"
        echo "stopped"
    else
        echo "not running"
    fi

    ps w | awk '$0 ~ /\/opt\/scripts\/[a]dguard-vpn-trigger.sh/ { print $1 }' | while read trigger_pid; do
        [ -n "$trigger_pid" ] && kill "$trigger_pid" 2>/dev/null || true
    done
    sleep 1
    rmdir /opt/var/run/adguardvpn-trigger.lock 2>/dev/null || true
    "$SCRIPT" cleanup >> "$LOG" 2>&1 || true
}

status() {
    if service_running; then
        echo "running, pid=$(cat "$PIDFILE")"
    else
        echo "not running"
    fi

    echo "--- last trigger status ---"
    cat "$LOG" 2>/dev/null
}

restart() {
    stop
    sleep 1
    start
}

case "$1" in
    start) start ;;
    stop) stop ;;
    restart) restart ;;
    status) status ;;
    *) echo "Usage: $0 {start|stop|restart|status}" ;;
esac
