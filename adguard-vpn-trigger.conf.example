# Dedicated Keenetic WireGuard interface used only as an ON/OFF switch.
# Replace this placeholder with the actual internal interface name.
SWITCH_IF="REPLACE_WITH_INTERFACE_NAME"

# Keenetic connection policy used only to select clients for AdGuard VPN.
POLICY_NAME="Policy0"

# Linux policy-routing table and rule priority.
TABLE_ID="100"
RULE_PRIORITY="90"

# Persistent AdGuard VPN profile and polling interval in seconds.
ADGUARD_HOME="/opt/home/adguardvpn"
# HTTPS URL fetched through tun0 in parallel to verify the tunnel.
# ICMP is not usable: AdGuard answers ping locally.
HEALTHCHECK_URL="https://www.google.com/generate_204"
HEALTHCHECK_PARALLEL="4"

# app.log is trimmed above this size; old tunnel.log.N copies are removed.
ADGUARD_LOG_MAX_KB="1024"

# AdGuard VPN protocols tried in order when a new session fails the check;
# the one that worked last is tried first.
PROTOCOLS="quic http2"
INTERVAL="120"
